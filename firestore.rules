rules_version = '2';

// Prosper Budget Planner — Firestore security rules
//
// All user data lives under users/{userId}/... . These rules ensure a
// signed-in user can only ever read or write their OWN document tree, and
// nothing else. Deploy via: firebase deploy --only firestore:rules
// (or paste into Firebase Console -> Firestore Database -> Rules).

service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read/write only their own subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied by default (no catch-all allow rule).
  }
}
